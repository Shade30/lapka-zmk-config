#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3
#define WIN 4

&lt {
    quick-tap-ms = <220>;
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    flavor = "balanced";
};

&mt {
    quick-tap-ms = <220>;
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    flavor = "balanced";
};

&mmv {
    time-to-max-speed-ms = <1000>;
};

&msc {
    time-to-max-speed-ms = <600>;
};

/ {

    behaviors {
        mt_h: mod_tap_home {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <170>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <300>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap H";
        };
        lt_h: layer_tap_home {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <300>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap H";
        };
    };

    combos {
        compatible = "zmk,combos";
// COMMON
//┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓   ┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓
//┃      ┃      ┃    (ESC)    ┃      ┃   ┃      ┃    (ESC)    ┃      ┃      ┃
//┃      ┃      ┃      ┃      ┃      ┃   ┃      ┃      ┃      ┃      ┃      ┃
//┃      ┃      ┃   (ENTER)   ┃      ┃   ┃      ┃   (ENTER)   ┃      ┃      ┃
//┗━━━━━━┻━━━━━━┫      ┃      ┃      ┃   ┃      ┃      ┃      ┣━━━━━━┻━━━━━━┛
//              ┗━━━━━━┻━━━━━━┻━━━━━━┛   ┗━━━━━━┻━━━━━━┻━━━━━━┛
        combo_esc_left {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&kp ESC>;
        };
        combo_esc_right {
            timeout-ms = <50>;
            key-positions = <6 7>;
            bindings = <&kp ESC>;
        };
        combo_ret_left {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&kp RET>;
        };
        combo_ret_right {
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&kp RET>;
        };
// DEFAULT
//┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓   ┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓
//┃      ┃      ┃      ┃      ┃      ┃   ┃      ┃      ┃     ([)    (])     ┃
//┃     (`)     ┃      ┃      ┃      ┃   ┃      ┃      ┃      ┃     (')     ┃
//┃      ┃      ┃      ┃      ┃      ┃   ┃      ┃      ┃      ┃     (\)     ┃
//┗━━━━━━┻━━━━━━┫      ┃      ┃      ┃   ┃      ┃      ┃      ┣━━━━━━┻━━━━━━┛
//              ┗━━━━━━┻━━━━━━┻━━━━━━┛   ┗━━━━━━┻━━━━━━┻━━━━━━┛
        combo_lbkt {
            timeout-ms = <50>;
            key-positions = <7 8>;
            layers = <DEF>;
            bindings = <&kp LBKT>;
        };
        combo_rbkt {
            timeout-ms = <50>;
            key-positions = <8 9>;
            layers = <DEF>;
            bindings = <&kp RBKT>;
        };
        combo_grave {
            timeout-ms = <50>;
            key-positions = <10 11>;
            layers = <DEF>;
            bindings = <&kp GRAVE>;
        };
        combo_quote {
            timeout-ms = <50>;
            key-positions = <18 19>;
            layers = <DEF>;
            bindings = <&kp SQT>;
        };
        combo_bslh {
            timeout-ms = <50>;
            key-positions = <28 29>;
            layers = <DEF>;
            bindings = <&kp BSLH>;
        };
// LOWER
//┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓   ┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓
//┃      ┃      ┃      ┃      ┃      ┃   ┃      ┃      ┃    (F11)  (F12)    ┃
//┃      ┃      ┃      ┃      ┃      ┃   ┃      ┃      ┃      ┃      ┃      ┃
//┃     (=)     ┃      ┃      ┃      ┃   ┃      ┃      ┃      ┃     (-)     ┃
//┗━━━━━━┻━━━━━━┫      ┃      ┃      ┃   ┃      ┃      ┃      ┣━━━━━━┻━━━━━━┛
//              ┗━━━━━━┻━━━━━━┻━━━━━━┛   ┗━━━━━━┻━━━━━━┻━━━━━━┛
        combo_f11 {
            timeout-ms = <50>;
            key-positions = <7 8>;
            layers = <LWR>;
            bindings = <&kp F11>;
        };
        combo_f12 {
            timeout-ms = <50>;
            key-positions = <8 9>;
            layers = <LWR>;
            bindings = <&kp F12>;
        };
        combo_equal {
            timeout-ms = <50>;
            key-positions = <20 21>;
            layers = <LWR>;
            bindings = <&kp EQUAL>;
        };
        combo_minus {
            timeout-ms = <50>;
            key-positions = <28 29>;
            layers = <LWR>;
            bindings = <&kp MINUS>;
        };
// RAISE
//┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓   ┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓
//┃      ┃      ┃      ┃      ┃      ┃   ┃      ┃      ┃      ┃      ┃      ┃
//┃      ┃      ┃      ┃      ┃      ┃   ┃      ┃      ┃      ┃      ┃      ┃
//┃   (NUMLCK)  ┃      ┃      ┃      ┃   ┃      ┃      ┃      ┃     (_)     ┃
//┗━━━━━━┻━━━━━━┫      ┃      ┃      ┃   ┃      ┃      ┃      ┣━━━━━━┻━━━━━━┛
//              ┗━━━━━━┻━━━━━━┻━━━━━━┛   ┗━━━━━━┻━━━━━━┻━━━━━━┛
        combo_numlock {
            timeout-ms = <50>;
            key-positions = <20 21>;
            layers = <RSE>;
            bindings = <&kp KP_NLCK>;
        };
        combo_under {
            timeout-ms = <50>;
            key-positions = <28 29>;
            layers = <RSE>;
            bindings = <&kp UNDER>;
        };
// ADJUST
//┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓   ┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓
//┃      ┃      ┃      ┃      ┃      ┃   ┃      ┃      ┃      ┃      ┃      ┃
//┃      ┃      ┃      ┃      ┃      ┃   ┃      ┃      ┃      ┃      ┃      ┃
//┃   (BTCLR)   ┃      ┃      ┃      ┃   ┃      ┃      ┃      ┃      ┃      ┃
//┗━━━━━━┻━━━━━━┫      ┃      ┃      ┃   ┃      ┃      ┃      ┣━━━━━━┻━━━━━━┛
//              ┗━━━━━━┻━━━━━━┻━━━━━━┛   ┗━━━━━━┻━━━━━━┻━━━━━━┛
        combo_btclr {
            timeout-ms = <50>;
            key-positions = <20 21>;
            layers = <ADJ>;
            bindings = <&bt BT_CLR>;
        };
// WIN
//┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓   ┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓
//┃      ┃      ┃      ┃      ┃      ┃   ┃      ┃      ┃      ┃      ┃      ┃
//┃      ┃      ┃      ┃      ┃      ┃   ┃      ┃      ┃      ┃      ┃      ┃
//┃   (GUI `)   ┃      ┃      ┃      ┃   ┃      ┃      ┃      ┃   (GUI `)   ┃
//┗━━━━━━┻━━━━━━┫      ┃      ┃      ┃   ┃      ┃      ┃      ┣━━━━━━┻━━━━━━┛
//              ┗━━━━━━┻━━━━━━┻━━━━━━┛   ┗━━━━━━┻━━━━━━┻━━━━━━┛
        combo_gui_grave_left {
            timeout-ms = <50>;
            key-positions = <20 21>;
            layers = <WIN>;
            bindings = <&kp LG(GRAVE)>;
        };
        combo_gui_grave_right {
            timeout-ms = <50>;
            key-positions = <28 29>;
            layers = <WIN>;
            bindings = <&kp LG(GRAVE)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "DEF";
//┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓   ┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓
//┃   Q  ┃   W  ┃   E  ┃   R  ┃   T  ┃   ┃   Y  ┃   U  ┃   I  ┃   O  ┃   P  ┃
//┃ WIN/A┃LGUI/S┃LALT/D┃CTRL/F┃   G  ┃   ┃   H  ┃CTRL/J┃RALT/K┃RGUI/L┃ WIN/;┃
//┃ WIN/Z┃   X  ┃   C  ┃   V  ┃   B  ┃   ┃   N  ┃   M  ┃   ,  ┃   .  ┃ WIN//┃
//┗━━━━━━┻━━━━━━┫RS/TAB┃SH/SPC┃LW/RET┃   ┃LW/ESC┃SH/BSP┃RS/DEL┣━━━━━━┻━━━━━━┛
//              ┗━━━━━━┻━━━━━━┻━━━━━━┛   ┗━━━━━━┻━━━━━━┻━━━━━━┛

            bindings = <

                &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U &kp I &kp O &kp P
                &lt_h WIN A &mt_h LGUI S &mt_h LALT D &mt_h LCTRL F &kp G   &kp H &mt_h RCTRL J &mt_h RALT K &mt_h RGUI L &lt_h WIN SEMI
                &lt WIN Z &kp X &kp C &kp V &kp B   &kp N &kp M &kp COMMA &kp DOT &lt WIN FSLH
                &lt RSE TAB &mt LSHFT SPACE &lt LWR RET   &lt LWR ESC &mt RSHFT BSPC &lt RSE DEL
            >;
        };

        lower_layer {
            display-name = "LWR";
//┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓   ┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓
//┃  F1  ┃  F2  ┃  F3  ┃  F4  ┃  F5  ┃   ┃  F6  ┃  F7  ┃  F8  ┃  F9  ┃  F10 ┃
//┃   !  ┃LGUI/@┃LALT/#┃CTRL/$┃   %  ┃   ┃   ˆ  ┃CTRL/&┃RALT/*┃RGUI/(┃   )  ┃
//┃   1  ┃   2  ┃   3  ┃   4  ┃   5  ┃   ┃   6  ┃   7  ┃   8  ┃   9  ┃   0  ┃
//┗━━━━━━┻━━━━━━┫  ADJ ┃ -//- ┃ -//- ┃   ┃ -//- ┃ -//- ┃  ADJ ┣━━━━━━┻━━━━━━┛
//              ┗━━━━━━┻━━━━━━┻━━━━━━┛   ┗━━━━━━┻━━━━━━┻━━━━━━┛

            bindings = <

                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5   &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
                &kp EXCL &mt_h LGUI AT &mt_h LALT HASH &mt_h LCTRL DLLR &kp PRCNT   &kp CARET &mt_h RCTRL AMPS &mt_h RALT ASTRK &mt_h RGUI LPAR &kp RPAR
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5   &kp N6 &kp N7 &kp N8 &kp N9 &kp N0
                &mo ADJ &trans &trans   &trans &trans &mo ADJ
            >;
        };

        raise_layer {
            display-name = "RSE";
//┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓   ┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓
//┃ KP * ┃ KP 7 ┃ KP 8 ┃ KP 9 ┃ KP + ┃   ┃ CAPS ┃ HOME ┃PRT SC┃ P UP ┃   |  ┃
//┃ KP / ┃LG/KP4┃LA/KP5┃LC/KP6┃ KP - ┃   ┃ LEFT ┃ DOWN ┃  UP  ┃ RIGHT┃INSERT┃
//┃ KP 0 ┃ KP 1 ┃ KP 2 ┃ KP 3 ┃ KP . ┃   ┃SCRLCK┃  END ┃ PAUSE┃P DOWN┃   \  ┃
//┗━━━━━━┻━━━━━━┫ -//- ┃ -//- ┃  ADJ ┃   ┃  ADJ ┃ -//- ┃ -//- ┣━━━━━━┻━━━━━━┛
//              ┗━━━━━━┻━━━━━━┻━━━━━━┛   ┗━━━━━━┻━━━━━━┻━━━━━━┛

            bindings = <

                &kp KP_MULTIPLY &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_PLUS   &kp CAPS &kp HOME &kp PSCRN &kp PG_UP &kp PIPE
                &kp KP_DIVIDE &mt_h LGUI KP_N4 &mt_h LALT KP_N5 &mt_h LCTRL KP_N6 &kp KP_MINUS   &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp INSERT
                &kp KP_N0 &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_DOT   &kp SLCK &kp END &kp PAUSE_BREAK &kp PG_DN &kp BSLH
                &trans &trans &mo ADJ   &mo ADJ &trans &trans
            >;
        };

        adjust_layer {
            display-name = "ADJ";
//┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓   ┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓
//┃ BTLDR┃OUT TG┃ STUD ┃pwrOFF┃sftOFF┃   ┃      ┃      ┃      ┃      ┃      ┃
//┃      ┃ LGUI ┃ LALT ┃ LCTRL┃BT CLR┃   ┃      ┃MS LFT┃ MS UP┃MS RGT┃MS W U┃
//┃  BT0 ┃  BT1 ┃  BT2 ┃  BT3 ┃  BT4 ┃   ┃      ┃MS W L┃ MS DN┃MS W R┃MS W D┃
//┗━━━━━━┻━━━━━━┫ -//- ┃ -//- ┃ -//- ┃   ┃lftCLK┃mdlCLK┃rgtCLK┣━━━━━━┻━━━━━━┛
//              ┗━━━━━━┻━━━━━━┻━━━━━━┛   ┗━━━━━━┻━━━━━━┻━━━━━━┛

            bindings = <

                &bootloader &out OUT_TOG &studio_unlock &ext_power EP_OFF &soft_off   &none &none &none &none &none
                &none &kp LGUI &kp LALT &kp LCTRL &bt BT_CLR   &none &mmv MOVE_LEFT &mmv MOVE_UP &mmv MOVE_RIGHT &msc SCRL_UP
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &none &msc SCRL_LEFT &mmv MOVE_DOWN &msc SCRL_RIGHT &msc SCRL_DOWN
                &trans &trans &trans   &mkp MB1 &mkp MB3 &mkp MB2
            >;
        };
        win_layer {
            display-name = "WIN";
//┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓   ┏━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┳━━━━━━┓
//┃   `  ┃      ┃      ┃      ┃      ┃   ┃  F11 ┃  F12 ┃ GUI L┃   [  ┃   ]  ┃
//┃ GS 1 ┃ GS 2 ┃ GS 3 ┃ GS 4 ┃      ┃   ┃ LC ` ┃CTRL/-┃RALT/=┃RGUI/\┃   '  ┃
//┃ GUI 1┃ GUI 2┃ GUI 3┃ GUI 4┃ GUI 5┃   ┃ GUI 6┃ GUI 7┃ GUI 8┃ GUI 9┃ GUI 0┃
//┗━━━━━━┻━━━━━━┫ -//- ┃ -//- ┃ -//- ┃   ┃ -//- ┃ -//- ┃ -//- ┣━━━━━━┻━━━━━━┛
//              ┗━━━━━━┻━━━━━━┻━━━━━━┛   ┗━━━━━━┻━━━━━━┻━━━━━━┛

            bindings = <

                &kp GRAVE &none &none &none &none   &kp F11 &kp F12 &kp LG(L) &kp LBKT &kp RBKT
                &kp LG(LS(N1)) &kp LG(LS(N2)) &kp LG(LS(N3)) &kp LG(LS(N4)) &none   &kp LC(GRAVE) &mt_h RCTRL MINUS &mt_h RALT EQUAL &mt_h RGUI BSLH &kp SQT
                &kp LG(N1) &kp LG(N2) &kp LG(N3) &kp LG(N4) &kp LG(N5)   &kp LG(N6) &kp LG(N7) &kp LG(N8) &kp LG(N9) &kp LG(N0)
                &trans &trans &trans   &trans &trans &trans
            >;
        };
    };
};
